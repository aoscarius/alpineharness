### SECURITY & GIT CONFIGURATION:
# Set to false to block the agent from accessing your SSH keys (disables pushing and signing)
ALLOW_GIT_SSH=false
# Set to false to hide your global .gitconfig (makes the agent anonymous inside the container)
ALLOW_GIT_CONFIG=false

### DOCKER RESOURCE LIMITS:
# Limits the maximum memory the container can use (e.g., 2g, 4g) to prevent host freezing
DOCKER_MAX_MEMORY=4g
# Limits the number of CPU cores the container can utilize (e.g., 2, 1.5)
DOCKER_MAX_CPUS=2

### NETWORK SETTINGS:
# Set the Docker network mode (e.g., bridge, host, none, or a custom network name)
DOCKER_NETWORK=host

### AUTHENTICATION & PROVIDERS:
# Insert your OpenRouter API key here
OPENROUTER_API_KEY=sk-or-v1-...