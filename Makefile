DISTRO ?= alpine
HARNESS ?= pi
IMAGE_NAME = $(HARNESS)$(DISTRO):dev
DOCKERFILE_PATH = docker.$(DISTRO)
BIN_DIR = $(HOME)/.local/bin
SHARE_DIR = $(HOME)/.local/share/$(DISTRO)
WRAPPER_PATH = $(BIN_DIR)/$(HARNESS)
CONFIG_FILE = docker.env

# Include the local env file to parse variables at build time
ifneq ($(wildcard $(CONFIG_FILE)),)
    include $(CONFIG_FILE)
endif

OPENROUTER_API_KEY ?= ""
ALLOW_GIT_SSH ?= true
ALLOW_GIT_CONFIG ?= true
DOCKER_NETWORK ?= bridge
DOCKER_MAX_MEMORY ?= 4g
DOCKER_MAX_CPUS ?= 2

.PHONY: install build uninstall help

help:
	@echo "Available commands:"
	@echo "  make install [HARNESS=pi] 	 - Build selected harness image and deploy wrapper to $(BIN_DIR)"
	@echo "  make build [HARNESS=pi]     - Build selected harness Docker image only"
	@echo "  make uninstall [HARNESS=pi] - Completely remove the wrapper, templates, and shared assets"

install: build
	@mkdir -p $(BIN_DIR)
	@mkdir -p $(SHARE_DIR)
	@touch $(CONFIG_FILE)
	@cp -f $(CONFIG_FILE) $(SHARE_DIR)/.env
	
	@echo '#!/bin/bash' > $(WRAPPER_PATH)
	@echo '# Generated by Makefile - Isolated Project Workspace Wrapper' >> $(WRAPPER_PATH)
	@echo 'HARNESS="$(HARNESS)"' >> $(WRAPPER_PATH)
	@echo 'IMAGE_NAME="$(IMAGE_NAME)"' >> $(WRAPPER_PATH)
	@echo '' >> $(WRAPPER_PATH)

	@echo '# Dynamically generate a unique container name using a short 8-character UUID suffix' >> $(WRAPPER_PATH)
	@echo 'CONTAINER_NAME="sandbox-$$HARNESS-"$$(cat /proc/sys/kernel/random/uuid | cut -d '-' -f 1)' >> $(WRAPPER_PATH)
	@echo '' >> $(WRAPPER_PATH)

	@echo 'CURRENT_WORKSPACE="$$(pwd)"' >> $(WRAPPER_PATH)
	@echo 'STRUCTURE_CREATED=false' >> $(WRAPPER_PATH)
	@echo '' >> $(WRAPPER_PATH)
	
	@echo 'if [ ! -d "$$CURRENT_WORKSPACE/.$$HARNESS" ]; then' >> $(WRAPPER_PATH)
	@echo '    mkdir -p "$$CURRENT_WORKSPACE/.$$HARNESS"' >> $(WRAPPER_PATH)
	@echo '    cp -f "$(SHARE_DIR)/.env" "$$CURRENT_WORKSPACE/.env"' >> $(WRAPPER_PATH)
	@echo '    STRUCTURE_CREATED=true' >> $(WRAPPER_PATH)
	@echo 'fi' >> $(WRAPPER_PATH)
	@echo '' >> $(WRAPPER_PATH)

	@echo 'if [ "$$STRUCTURE_CREATED" = "true" ] && { [ -d "$$CURRENT_WORKSPACE/.git" ] || [ -f "$$CURRENT_WORKSPACE/.git" ]; }; then' >> $(WRAPPER_PATH)
	@echo '    GITIGNORE="$$CURRENT_WORKSPACE/.gitignore"' >> $(WRAPPER_PATH)
	@echo '    touch "$$GITIGNORE"' >> $(WRAPPER_PATH)
	@echo '    if ! grep -q "^\.$$HARNESS/\$$" "$$GITIGNORE"; then' >> $(WRAPPER_PATH)
	@echo '        echo ".$$HARNESS/" >> "$$GITIGNORE"' >> $(WRAPPER_PATH)
	@echo '    fi' >> $(WRAPPER_PATH)
	@echo '    if ! grep -q "^\.env\$$" "$$GITIGNORE"; then' >> $(WRAPPER_PATH)
	@echo '        echo ".env" >> "$$GITIGNORE"' >> $(WRAPPER_PATH)
	@echo '    fi' >> $(WRAPPER_PATH)
	@echo 'fi' >> $(WRAPPER_PATH)
	@echo '' >> $(WRAPPER_PATH)

	@echo 'if [ -f "$$CURRENT_WORKSPACE/.env" ]; then' >> $(WRAPPER_PATH)
	@echo '    export $$(grep -v '"'"'^#'"'"' "$$CURRENT_WORKSPACE/.env" | xargs)' >> $(WRAPPER_PATH)
	@echo 'fi' >> $(WRAPPER_PATH)
	@echo '' >> $(WRAPPER_PATH)
	
	@echo 'USER_UID=$$(id -u)' >> $(WRAPPER_PATH)
	@echo 'USER_GID=$$(id -g)' >> $(WRAPPER_PATH)
	@echo '' >> $(WRAPPER_PATH)

	@echo 'DOCKER_ARGS=("-it" "--rm")' >> $(WRAPPER_PATH)
	@echo 'DOCKER_ARGS+=("--name" "$$CONTAINER_NAME")' >> $(WRAPPER_PATH)
	@echo 'DOCKER_ARGS+=("--env-file=$$CURRENT_WORKSPACE/.env")' >> $(WRAPPER_PATH)
	@echo 'DOCKER_ARGS+=("-w" "/workspace")' >> $(WRAPPER_PATH)
	@echo 'DOCKER_ARGS+=("-v" "$$CURRENT_WORKSPACE/.$$HARNESS:/home/sandbox/.$$HARNESS")' >> $(WRAPPER_PATH)
	@echo 'DOCKER_ARGS+=("-v" "$$CURRENT_WORKSPACE:/workspace")' >> $(WRAPPER_PATH)
	@echo 'DOCKER_ARGS+=("--network=$$DOCKER_NETWORK")' >> $(WRAPPER_PATH)
	@echo 'DOCKER_ARGS+=("--memory=$$DOCKER_MAX_MEMORY" "--cpus=$$DOCKER_MAX_CPUS")' >> $(WRAPPER_PATH)
	@echo '' >> $(WRAPPER_PATH)

	@echo 'if [ "$$ALLOW_GIT_SSH" = "true" ] && [ -d "$$HOME/.ssh" ]; then DOCKER_ARGS+=("-v" "$$HOME/.ssh:/home/sandbox/.ssh:ro"); fi' >> $(WRAPPER_PATH)
	@echo 'if [ "$$ALLOW_GIT_CONFIG" = "true" ] && [ -f "$$HOME/.gitconfig" ]; then DOCKER_ARGS+=("-v" "$$HOME/.gitconfig:/home/sandbox/.gitconfig:ro"); fi' >> $(WRAPPER_PATH)
	@echo '' >> $(WRAPPER_PATH)

	@echo '# Determine the appropriate privilege dropping command based on the OS' >> $(WRAPPER_PATH)
	@echo 'source /etc/os-release' >> $(WRAPPER_PATH)
	@echo 'if [ "$$ID" = "alpine" ]; then' >> $(WRAPPER_PATH)
	@echo '    SUCMD="su-exec"' >> $(WRAPPER_PATH)
	@echo 'else' >> $(WRAPPER_PATH)
	@echo '    SUCMD="gosu"' >> $(WRAPPER_PATH)
	@echo 'fi' >> $(WRAPPER_PATH)
	@echo '' >> $(WRAPPER_PATH)

	@echo '# Entrypoint command: creates user/group dynamically, configures passwordless sudo, and drops privileges' >> $(WRAPPER_PATH)
	@echo 'ENTRYPOINT_CMD="mkdir -p /home/sandbox /workspace && \' >> $(WRAPPER_PATH)
	@echo 'grep -q \":x:$$USER_GID:\" /etc/group || echo \"sandbox_group:x:$$USER_GID:\" >> /etc/group && \' >> $(WRAPPER_PATH)
	@echo 'grep -q \":x:$$USER_UID:\" /etc/passwd || echo \"sandbox:x:$$USER_UID:$$USER_GID:sandbox:/home/sandbox:/bin/bash\" >> /etc/passwd && \' >> $(WRAPPER_PATH)
	@echo 'if [ -f /etc/sudoers ]; then chmod 0640 /etc/sudoers && sed -i '"'/sandbox ALL/d'"' /etc/sudoers && echo \"sandbox ALL=(ALL) NOPASSWD: ALL\" >> /etc/sudoers && chmod 0440 /etc/sudoers; fi && \' >> $(WRAPPER_PATH)
	@echo 'chown -R $$USER_UID:$$USER_GID /home/sandbox /workspace && \' >> $(WRAPPER_PATH)
	@echo 'exec $$SUCMD $$USER_UID:$$USER_GID env HOME=/home/sandbox USER=sandbox LOGNAME=sandbox HISTFILE=/home/sandbox/.bash_history PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin TERM=$$TERM \"\$$@\""' >> $(WRAPPER_PATH)
	@echo '' >> $(WRAPPER_PATH)

	@echo '# Determine if the user wants to run a shell or execute a command' >> $(WRAPPER_PATH)
	@echo 'if [ "$${1:-}" = "--shell" ]; then CMD=(/bin/bash -l); else CMD=("$$HARNESS" "$$@"); fi' >> $(WRAPPER_PATH)
	@echo '' >> $(WRAPPER_PATH)
	
	@echo 'docker run "$${DOCKER_ARGS[@]}" --entrypoint /bin/bash $$IMAGE_NAME -c "$$ENTRYPOINT_CMD" -- $${CMD[@]} || rc=$?' >> $(WRAPPER_PATH)
	@chmod +x $(WRAPPER_PATH)
	
	@echo "Installation complete!"
	@echo "Global project wrapper deployed at: $(WRAPPER_PATH)"
	@echo "Shared template file configured at: $(SHARE_DIR)/.env"
	@echo "Make sure $(BIN_DIR) is in your PATH."

build:
	docker build -f $(DOCKERFILE_PATH) --build-arg HARNESS=$(HARNESS) -t $(IMAGE_NAME) .

uninstall:
	rm -f $(WRAPPER_PATH)
	rm -rf $(SHARE_DIR)
	@echo "Global wrapper and shared template configurations purged successfully."
