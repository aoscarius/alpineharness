FROM ubuntu:24.04

# Accepts the desired harness as a build argument (Default: pi)
ARG HARNESS=pi

ENV DEBIAN_FRONTEND=noninteractive

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PIP_NO_CACHE_DIR=1 \
    ENV=/etc/profile

# Single layer for package installation and Python symlinks
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Base / shell / network / privileges
    ca-certificates curl wget bash bash-completion gosu sudo gnupg \
    # VCS
    git \
    # Search / editing / inspection
    ripgrep fd-find jq tree nano vim htop \
    # C / C++ toolchain & build systems
    build-essential gcc g++ make libc6-dev linux-headers-generic gdb strace \
    # Rust
    rustc cargo \
    # Go
    golang-go \
    # Python
    python3 python3-dev python3-pip python3-setuptools \
    && rm -rf /var/lib/apt/lists/* \
    # Link fd-find to match Alpine's 'fd' command binary name
    && ln -sf /usr/bin/fdfind /usr/bin/fd \
    # Link execution paths for standard Python usage
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && ln -sf /usr/bin/pip3 /usr/bin/pip

# Install Node.js 24 system-wide using NodeSource
RUN NODE_MAJOR=24 && curl -fsSL https://deb.nodesource.com/setup_$NODE_MAJOR.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Overrides the system package restriction for pip
RUN rm -f /usr/lib/python3.*/EXTERNALLY-MANAGED

# Install selected harness package globally via npm or custom script
RUN case "${HARNESS}" in \
        opencode) npm install -g opencode-ai@latest ;; \
        omp)      curl -fsSL https://omp.sh | sh && mv /root/.local/bin/omp /usr/bin/omp || true ;; \
        pi|*)     npm install -g --ignore-scripts @earendil-works/pi-coding-agent ;; \
    esac \
    && chmod +x /usr/bin/omp 2>/dev/null || true \
    && rm -rf /root/.npm /root/.cache /root/.local /tmp/* 2>/dev/null || true

# Configure default bash profile
RUN mkdir -p /etc/profile.d && cat > /etc/profile.d/prompt.sh <<'EOF'
# Define a function to display the current git branch
gitbranch() {
  branch=$(git branch --show-current 2>/dev/null)
  [ -n "$branch" ] && echo " $branch"
}
# Configure a colorful prompt for bash shells
if [ -n "$BASH_VERSION" ]; then
  RESET="\[\033[0m\]"
  ARROW="\[\033[38;5;117m\]➜$RESET"
  DIR="\[\033[38;5;81m\]\w$RESET"
  GIT_COLOR="\[\033[38;5;49m\]"
  PS1="$ARROW $DIR$GIT_COLOR \$(gitbranch)$RESET\n\$ "
  export PS1
fi
# Configure default bash aliases
alias ls='ls --color=auto'
alias ll='ls -lah --color=auto'
alias grep='grep --color=auto'
EOF

# Permit passwordless sudo execution for members of the sudo group
RUN echo '%sudo ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers

# Set up standard working directory
WORKDIR /workspace
